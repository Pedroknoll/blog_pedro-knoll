{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/blog/2026-10-por-que-este-blog/",
        "http://localhost/blog/2026-10-como-o-blog-e-feito/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000, "aggregationMethod": "median" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median" }
        ],
        "categories:performance": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ],
        "categories:seo": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
