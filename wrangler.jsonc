{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "pedroknoll.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
