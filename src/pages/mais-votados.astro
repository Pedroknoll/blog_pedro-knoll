---
import ListPage from "~/components/ui/ListPage.astro";
import TagFilter from "~/components/ui/TagFilter.astro";
import TopVoted from "~/components/ui/TopVoted.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPublishedPosts } from "~/lib/getPublishedPosts";
import { pageCatalog } from "~/lib/page-catalog";
import { absoluteUrl, pageTitle } from "~/lib/seo";
import { collectTags } from "~/lib/tags";
import { site } from "~/site.config";

const posts = await getPublishedPosts();
const catalogJson = await pageCatalog(posts);
const heading = "Mais votados";
---

<BaseLayout
  title={pageTitle({ page: heading }, site)}
  description="Posts com pelo menos um voto."
  canonical={absoluteUrl(Astro.url.pathname, Astro.site)}
  ogTitle={heading}
  ogType="website"
>
  <ListPage heading={heading} icon="fire">
    <TagFilter
      slot="aside"
      tags={collectTags(posts)}
      total={posts.length}
      noun={{ one: "post", many: "posts" }}
      pending
    />
    <TopVoted catalogJson={catalogJson} headingLevel={2} layout="list" />
  </ListPage>
</BaseLayout>
