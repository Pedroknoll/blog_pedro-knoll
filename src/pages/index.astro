---
import Greeting from "~/components/ui/Greeting.astro";
import HomeColumns from "~/components/ui/HomeColumns.astro";
import HomeSection from "~/components/ui/HomeSection.astro";
import Listing from "~/components/ui/Listing.astro";
import TopVoted from "~/components/ui/TopVoted.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPublishedPosts } from "~/lib/getPublishedPosts";
import { homeLinks, homeLists } from "~/lib/home-lists";
import { pageCatalog } from "~/lib/page-catalog";
import { absoluteUrl, pageTitle } from "~/lib/seo";
import { site } from "~/site.config";

const posts = await getPublishedPosts();
const { recent, prototypes, totals } = homeLists(posts);
const catalogJson = await pageCatalog(posts);
const links = homeLinks(totals);
const paired = prototypes.length > 0;
---

<BaseLayout
  title={pageTitle({}, site)}
  description={site.author.bio}
  canonical={absoluteUrl(Astro.url.pathname, Astro.site)}
  ogTitle={site.title}
  ogType="website"
>
  <HomeColumns>
    <Greeting slot="greeting" />
    <HomeSection label="/ RECENTES" href="/blog/" link={links.posts} compact>
      <Listing
        heading="Recentes"
        showHeading={false}
        frame={false}
        posts={recent}
        headingLevel={3}
        layout="recent"
        topBorder={false}
        dim={false}
      />
    </HomeSection>
    <div
      class:list={[
        "mt-4 px-4 pb-10 sm:mt-10",
        paired && "lg:grid lg:grid-cols-2 lg:gap-x-16",
      ]}
    >
      <HomeSection
        label="/ MAIS VOTADOS"
        href="/mais-votados/"
        link={links.ranking}
        padded={false}
        compact
      >
        <TopVoted
          catalogJson={catalogJson}
          headingLevel={3}
          limit={10}
          layout="ranked"
        />
      </HomeSection>
      {paired && (
        <HomeSection
          label="/ PROTÓTIPOS"
          href="/prototipos/"
          link={links.prototypes}
          padded={false}
          compact
        >
          <Listing
            heading="Protótipos"
            showHeading={false}
            frame={false}
            posts={prototypes}
            headingLevel={3}
            layout="prototype"
            dim={false}
          />
        </HomeSection>
      )}
    </div>
  </HomeColumns>
</BaseLayout>
