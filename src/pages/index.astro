---
import Greeting from "~/components/ui/Greeting.astro";
import HomeColumns from "~/components/ui/HomeColumns.astro";
import HomeSection from "~/components/ui/HomeSection.astro";
import Listing from "~/components/ui/Listing.astro";
import TopVoted from "~/components/ui/TopVoted.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPublishedPosts } from "~/lib/getPublishedPosts";
import { homeLists } from "~/lib/home-lists";
import { pageCatalog } from "~/lib/page-catalog";
import { absoluteUrl, pageTitle } from "~/lib/seo";
import { site } from "~/site.config";

const posts = await getPublishedPosts();
const { recent, prototypes } = homeLists(posts);
const catalogJson = await pageCatalog(posts);
const paired = prototypes.length > 0;
---

<BaseLayout
  title={pageTitle({}, site)}
  description={site.author.bio}
  canonical={absoluteUrl(Astro.url.pathname, Astro.site)}
  ogTitle={site.title}
  ogType="website"
>
  <HomeColumns>
    <Greeting slot="greeting" />
    <HomeSection
      label="/ RECENTES"
      href="/blog/"
      more=" os posts recentes"
      compact
    >
      <Listing
        heading="Recentes"
        showHeading={false}
        frame={false}
        posts={recent}
        headingLevel={3}
        layout="columns"
        topBorder={false}
      />
    </HomeSection>
    <div
      class:list={[
        "mt-10 px-4 pb-10",
        paired && "lg:grid lg:grid-cols-2 lg:gap-x-16",
      ]}
    >
      <HomeSection
        label="/ MAIS VOTADOS"
        href="/mais-votados/"
        more=" os mais votados"
        padded={false}
        compact
      >
        <TopVoted
          catalogJson={catalogJson}
          headingLevel={3}
          limit={10}
          layout="votes"
        />
      </HomeSection>
      {paired && (
        <HomeSection
          label="/ PROTÓTIPOS"
          href="/prototipos/"
          more=" os protótipos"
          padded={false}
          compact
        >
          <Listing
            heading="Protótipos"
            showHeading={false}
            frame={false}
            posts={prototypes}
            headingLevel={3}
            layout="titles"
          />
        </HomeSection>
      )}
    </div>
  </HomeColumns>
</BaseLayout>
