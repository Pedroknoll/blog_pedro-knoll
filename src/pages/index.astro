---
import Greeting from "~/components/ui/Greeting.astro";
import Listing from "~/components/ui/Listing.astro";
import TagFilter from "~/components/ui/TagFilter.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { splitFeatured } from "~/lib/featured";
import { getPublishedPosts } from "~/lib/getPublishedPosts";
import { PAGE_SIZE, paginatePosts } from "~/lib/pagination";
import { absoluteUrl, pageTitle } from "~/lib/seo";
import { collectTags } from "~/lib/tags";
import { site } from "~/site.config";

const posts = await getPublishedPosts();
const { featured, rest } = splitFeatured(posts);
const [page] = paginatePosts(rest, PAGE_SIZE);

if (!page) {
  throw new Error("A listagem não tem a página 1.");
}
---

<BaseLayout
  title={pageTitle({}, site)}
  description={site.author.bio}
  canonical={absoluteUrl(Astro.url.pathname, Astro.site)}
  ogTitle={site.title}
  ogType="website"
>
  <Greeting />
  <TagFilter tags={collectTags(posts)} current={null} />
  <Listing
    heading="Blog"
    showHeading={false}
    featured={featured}
    posts={page.items}
    prev={page.prev}
    next={page.next}
  />
</BaseLayout>
