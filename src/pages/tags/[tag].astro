---
import type { CollectionEntry } from "astro:content";

import Listing from "~/components/ui/Listing.astro";
import TagFilter from "~/components/ui/TagFilter.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getPublishedPosts } from "~/lib/getPublishedPosts";
import { absoluteUrl, pageTitle } from "~/lib/seo";
import { collectTags, postsWithTag } from "~/lib/tags";
import { site } from "~/site.config";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectTags(posts).map((tag) => ({
    params: { tag },
    props: { posts: postsWithTag(posts, tag) },
  }));
}

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const tag = Astro.params.tag;

if (!tag) {
  throw new Error("Tag ausente.");
}

const allPosts = await getPublishedPosts();
const heading = `Tag: ${tag}`;
---

<BaseLayout
  title={pageTitle({ page: heading }, site)}
  description={`Posts com a tag ${tag}.`}
  canonical={absoluteUrl(Astro.url.pathname, Astro.site)}
  ogTitle={heading}
  ogType="website"
>
  <TagFilter tags={collectTags(allPosts)} current={tag} />
  <Listing heading={heading} posts={posts} prev={null} next={null} />
</BaseLayout>
