---
import Figure from "~/components/viz/Figure.astro";

interface Props {
  number: number;
}

const { number } = Astro.props;
---

<Figure
  number={number}
  name="angulo-cosseno"
  width={280}
  height={240}
  title="Dois vetores e o ângulo entre eles"
  summary="Dois vetores saem da origem, u = (3, 1) e v = (1, 2), com um arco marcando o ângulo θ de 45° entre eles."
  caption="A similaridade de cosseno olha só para o ângulo entre os vetores, e não para o comprimento deles."
  data={{
    columns: ["Vetor", "Coordenadas"],
    rows: [
      ["u", "(3, 1)"],
      ["v", "(1, 2)"],
      ["θ", "45°"],
      ["cos θ", "0,71"],
    ],
  }}
>
  <line
    x1={72}
    y1={208}
    x2={216}
    y2={160}
    class="stroke-ink"
    stroke-width="1"
  />
  <line
    x1={216}
    y1={160}
    x2={208.2}
    y2={158.4}
    class="stroke-ink"
    stroke-width="1"
  />
  <line
    x1={216}
    y1={160}
    x2={210.7}
    y2={166}
    class="stroke-ink"
    stroke-width="1"
  />
  <line
    x1={72}
    y1={208}
    x2={120}
    y2={112}
    class="stroke-ink"
    stroke-width="1"
  />
  <line
    x1={120}
    y1={112}
    x2={113.3}
    y2={116.4}
    class="stroke-ink"
    stroke-width="1"
  />
  <line
    x1={120}
    y1={112}
    x2={120.5}
    y2={120}
    class="stroke-ink"
    stroke-width="1"
  />
  <path
    d="M 109.9 195.4 A 40 40 0 0 0 89.9 172.2"
    class="fill-none stroke-accent"
    stroke-width="1"
  />
  <text
    class="fill-ink font-mono"
    font-size="12"
    text-anchor="start"
    dominant-baseline="central"
    x={232}
    y={152}
  >
    u
  </text>
  <text
    class="fill-ink font-mono"
    font-size="12"
    text-anchor="middle"
    dominant-baseline="central"
    x={120}
    y={92}
  >
    v
  </text>
  <text
    class="fill-ink font-mono"
    font-size="12"
    text-anchor="middle"
    dominant-baseline="central"
    x={114}
    y={171}
  >
    θ
  </text>
</Figure>
