---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import "katex/dist/katex.min.css";

import CodeCopy from "~/components/ui/CodeCopy.astro";
import TagList from "~/components/ui/TagList.astro";
import Toc from "~/components/ui/Toc.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { formatPubDate } from "~/lib/format-date";
import { absoluteUrl, blogPostingJsonLd, pageTitle, postPath } from "~/lib/seo";
import type { TocItem } from "~/lib/toc";
import { site } from "~/site.config";

interface Props {
  post: CollectionEntry<"posts">;
  minutesRead?: number;
  hasCode?: boolean;
  toc: TocItem[];
}

const { post, minutesRead, hasCode, toc } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } =
  post.data;
const labelClass =
  "text-xs tracking-widest text-muted [font-variant-caps:small-caps]";
const published = formatPubDate(pubDate);
const updated = updatedDate ? formatPubDate(updatedDate) : undefined;
const canonical =
  post.data.canonical ?? absoluteUrl(postPath(post.id), Astro.site);

let image:
  { url: string; width: number; height: number; alt: string } | undefined;
if (cover && coverAlt) {
  const optimized = await getImage({
    src: cover,
    width: Math.min(1200, cover.width),
    format: "jpeg",
  });
  image = {
    url: absoluteUrl(optimized.src, Astro.site),
    width: optimized.attributes.width,
    height: optimized.attributes.height,
    alt: coverAlt,
  };
}

const jsonLd = blogPostingJsonLd({
  title,
  description,
  pubDate,
  updatedDate,
  authorName: site.author.name,
  canonical,
  image: image?.url,
});
---

<BaseLayout
  title={pageTitle({ page: title }, site)}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  updatedTime={updatedDate?.toISOString()}
  tags={tags}
  image={image}
  jsonLd={jsonLd}
>
  <article class="mx-auto w-full max-w-[72rem] px-4 py-10">
    <header>
      <h1 class="font-serif text-4xl leading-tight font-normal text-ink sm:text-5xl">
        {title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink">
        {description}
      </p>
      <div class="mt-8 grid grid-cols-2 gap-x-8 gap-y-6 border-y border-line py-6 sm:grid-cols-4">
        <div class="min-w-0">
          <p class={labelClass}>Autor</p>
          <p class="mt-2 text-sm text-ink">{site.author.name}</p>
        </div>
        <div class="min-w-0">
          <p class={labelClass}>Publicação</p>
          <p class="mt-2 text-sm text-ink">
            <time datetime={published.datetime}>{published.text}</time>
          </p>
          {updated && (
            <p class="mt-1 text-sm text-muted">
              <span>Atualizado em</span>{" "}
              <time datetime={updated.datetime}>{updated.text}</time>
            </p>
          )}
        </div>
        <div class="min-w-0">
          <p class={labelClass}>Leitura</p>
          {typeof minutesRead === "number" && (
            <p class="mt-2 text-sm text-ink">{minutesRead} min de leitura</p>
          )}
        </div>
        {tags.length > 0 && (
          <div class="min-w-0">
            <p class={labelClass}>Tags</p>
            <TagList class="mt-2 flex flex-wrap gap-2" tags={tags} />
          </div>
        )}
      </div>
    </header>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <Toc items={toc} />
      <div class="prose prose-site min-w-0 lg:col-start-1 lg:row-start-1">
        <slot />
      </div>
    </div>
    {hasCode && <CodeCopy />}
  </article>
</BaseLayout>
