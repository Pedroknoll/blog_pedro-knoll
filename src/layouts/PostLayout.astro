---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import "katex/dist/katex.min.css";
import "~/styles/katex-metric.css";

import CodeCopy from "~/components/ui/CodeCopy.astro";
import PostActions from "~/components/ui/PostActions.astro";
import PostAppendix from "~/components/ui/PostAppendix.astro";
import PostHeader from "~/components/ui/PostHeader.astro";
import PostRail from "~/components/ui/PostRail.astro";
import type { TocHeading } from "~/components/ui/PostToc.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import type { PostAppendixModel } from "~/lib/references";
import { absoluteUrl, blogPostingJsonLd, pageTitle, postPath } from "~/lib/seo";
import { site } from "~/site.config";

interface Props {
  post: CollectionEntry<"posts">;
  minutesRead?: number;
  hasCode?: boolean;
  appendix?: PostAppendixModel;
  tocHeadings?: TocHeading[];
}

const { post, minutesRead, hasCode, appendix, tocHeadings = [] } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  cover,
  coverAlt,
  kind,
} = post.data;
const postUrl = absoluteUrl(postPath(post.id), Astro.site);
const canonical = post.data.canonical ?? postUrl;

let image:
  { url: string; width: number; height: number; alt: string } | undefined;
if (cover && coverAlt) {
  const optimized = await getImage({
    src: cover,
    width: Math.min(1200, cover.width),
    format: "jpeg",
  });
  image = {
    url: absoluteUrl(optimized.src, Astro.site),
    width: optimized.attributes.width,
    height: optimized.attributes.height,
    alt: coverAlt,
  };
}

const jsonLd = blogPostingJsonLd({
  title,
  description,
  pubDate,
  updatedDate,
  authorName: site.author.name,
  canonical,
  image: image?.url,
});
---

<BaseLayout
  title={pageTitle({ page: title }, site)}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  updatedTime={updatedDate?.toISOString()}
  tags={tags}
  image={image}
  jsonLd={jsonLd}
>
  <article class="mx-auto w-full max-w-site px-4 pt-14 pb-10 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-16">
    <PostHeader
      title={title}
      description={description}
      pubDate={pubDate}
      minutesRead={minutesRead}
      kind={kind}
      tags={tags}
    />
    <PostRail
      slug={post.id}
      title={title}
      url={postUrl}
      headings={tocHeadings}
      minutesRead={minutesRead}
    />
    <div
      class="prose prose-site mt-10 min-w-0 lg:col-start-2 lg:row-start-2"
      data-pagefind-body
    >
      <slot />
    </div>
    <PostActions
      slug={post.id}
      title={title}
      url={postUrl}
      variant="end"
      class="mt-10 lg:col-start-2 lg:hidden"
    />
    {hasCode && <CodeCopy />}
  </article>
  {appendix && <PostAppendix appendix={appendix} />}
</BaseLayout>
