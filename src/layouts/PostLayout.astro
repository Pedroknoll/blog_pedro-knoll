---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import "katex/dist/katex.min.css";

import CodeCopy from "~/components/ui/CodeCopy.astro";
import PostAppendix from "~/components/ui/PostAppendix.astro";
import PostRail from "~/components/ui/PostRail.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import type { PostAppendixModel } from "~/lib/references";
import { absoluteUrl, blogPostingJsonLd, pageTitle, postPath } from "~/lib/seo";
import { site } from "~/site.config";

interface Props {
  post: CollectionEntry<"posts">;
  minutesRead?: number;
  hasCode?: boolean;
  appendix?: PostAppendixModel;
}

const { post, minutesRead, hasCode, appendix } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  cover,
  coverAlt,
  folio,
  kind,
  level,
} = post.data;
const canonical =
  post.data.canonical ?? absoluteUrl(postPath(post.id), Astro.site);

let image:
  { url: string; width: number; height: number; alt: string } | undefined;
if (cover && coverAlt) {
  const optimized = await getImage({
    src: cover,
    width: Math.min(1200, cover.width),
    format: "jpeg",
  });
  image = {
    url: absoluteUrl(optimized.src, Astro.site),
    width: optimized.attributes.width,
    height: optimized.attributes.height,
    alt: coverAlt,
  };
}

const jsonLd = blogPostingJsonLd({
  title,
  description,
  pubDate,
  updatedDate,
  authorName: site.author.name,
  canonical,
  image: image?.url,
});
---

<BaseLayout
  title={pageTitle({ page: title }, site)}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  updatedTime={updatedDate?.toISOString()}
  tags={tags}
  image={image}
  jsonLd={jsonLd}
>
  <article class="mx-auto w-full max-w-[72rem] px-4 pt-14 pb-10 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-16">
    <header class="flex flex-col lg:contents">
      <h1 class="font-display text-4xl font-semibold leading-tight text-balance text-ink sm:text-[2.75rem] lg:col-span-2 lg:text-[5rem] lg:leading-[1.02]">
        {title}
      </h1>
      <p class="mt-4 max-w-[52ch] text-lg text-muted lg:col-span-2 lg:text-xl">
        {description}
      </p>
      <PostRail
        title={title}
        folio={folio}
        pubDate={pubDate}
        updatedDate={updatedDate}
        minutesRead={minutesRead}
        kind={kind}
        level={level}
        tags={tags}
      />
    </header>
    <div class="prose prose-site mt-10 min-w-0 lg:col-start-2">
      <div
        data-prose-mark
        aria-hidden="true"
        class="not-prose max-lg:hidden border-b border-ink pb-2 mb-[1.5em] font-mono text-xs uppercase tracking-widest text-ink"
      >
        / Artigo
      </div>
      <slot />
    </div>
    {hasCode && <CodeCopy />}
  </article>
  {appendix && <PostAppendix appendix={appendix} />}
</BaseLayout>
