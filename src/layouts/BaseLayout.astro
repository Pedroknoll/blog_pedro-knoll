---
import { Font } from "astro:assets";

import "~/styles/global.css";
import Seo from "~/components/ui/Seo.astro";
import Footer from "~/components/ui/Footer.astro";
import Header from "~/components/ui/Header.astro";
import { absoluteUrl } from "~/lib/seo";
import { site } from "~/site.config";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle: string;
  ogType: "article" | "website";
  publishedTime?: string;
  updatedTime?: string;
  tags?: readonly string[];
  image?: {
    url: string;
    width: number;
    height: number;
    alt: string;
  };
  jsonLd?: unknown;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogType,
  publishedTime,
  updatedTime,
  tags,
  image,
  jsonLd,
} = Astro.props;
const rssHref = absoluteUrl("/rss.xml", Astro.site);
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font
      cssVariable="--font-plex-sans"
      preload={[{ weight: "400", style: "normal" }]}
    />
    <Font cssVariable="--font-plex-mono" />
    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-caveat" />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogTitle={ogTitle}
      ogType={ogType}
      ogSiteName={site.title}
      rssHref={rssHref}
      rssTitle={site.title}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      tags={tags}
      image={image}
      jsonLd={jsonLd}
    />
    <slot name="head" />
  </head>
  <body class="bg-surface text-ink">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-10 focus:bg-ink focus:px-3 focus:py-2 focus:text-surface"
      href="#conteudo"
    >
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
