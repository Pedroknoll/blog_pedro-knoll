---
import Grid from "./Grid.svelte";

type Data = {
  columns: string[];
  rows: (string | number)[][];
};

type Props =
  | {
      island?: false;
      number: number;
      caption: string;
      title: string;
      summary: string;
      name: string;
      width: number;
      height: number;
      data: Data;
    }
  | {
      island: true;
      number: number;
      caption: string;
      data: Data;
    };

const props = Astro.props;
const staticProps = props.island === true ? null : props;
---

<div class="not-prose my-8">
  <figure>
    {staticProps ? (
      <svg
        data-viz={staticProps.name}
        viewBox={`0 0 ${staticProps.width} ${staticProps.height}`}
        width={staticProps.width}
        height={staticProps.height}
        role="img"
        aria-label={staticProps.summary}
        class="block h-auto max-w-full"
      >
        <title>{staticProps.title}</title>
        <Grid width={staticProps.width} height={staticProps.height} />
        <slot />
      </svg>
    ) : (
      <slot />
    )}
    <figcaption class="mt-3 text-base text-muted">
      <span class="font-mono text-xs uppercase tracking-widest text-ink">
        Figura {props.number}
      </span>{" "}
      {props.caption}
    </figcaption>
  </figure>
  <details class="mt-2">
    <summary class="cursor-pointer py-1.5 font-mono text-xs uppercase tracking-widest text-muted">
      Ver dados
    </summary>
    <div class="overflow-x-auto">
      <table class="mt-2 border-collapse text-sm">
        <tr>
          {props.data.columns.map((column) => (
            <th
              scope="col"
              class="border-b border-line py-1.5 pr-4 text-left font-mono text-xs font-normal uppercase tracking-widest text-muted"
            >
              {column}
            </th>
          ))}
        </tr>
        {props.data.rows.map((row) => (
          <tr>
            {row.map((cell) => (
              <td class="border-b border-line py-1.5 pr-4 text-ink">{cell}</td>
            ))}
          </tr>
        ))}
      </table>
    </div>
  </details>
</div>
