---
import Article from "~/assets/brand/icones/icone-artigo.svg";
import Prototype from "~/assets/brand/icones/icone-prototipo.svg";
import { KIND_LABELS, type Kind } from "~/lib/kind";

interface Props {
  kind: Kind;
  px: 12 | 24;
}

const { kind, px } = Astro.props;

const icons = {
  article: Article,
  prototype: Prototype,
} as const;

const Icon = icons[kind];
---

<span class="font-mono text-xs uppercase tracking-widest text-ink">
  <Icon aria-hidden="true" width={px} height={px} class="inline-block" />{" "}
  <span>{KIND_LABELS[kind]}</span>
</span>
