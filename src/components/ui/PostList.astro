---
import type { CollectionEntry } from "astro:content";

import Card from "~/components/ui/Card.astro";
import ListSection from "~/components/ui/ListSection.astro";
import { minutesReadOf } from "~/lib/reading-minutes";

// Lista inteira sob o rótulo `/ LISTAGEM` (T-131, Q24, BRAND §9.2), por data;
// o título do post é h3.

interface Props {
  posts: CollectionEntry<"posts">[];
  thumb?: boolean;
}

const { posts, thumb = false } = Astro.props;
const items = await Promise.all(
  posts.map(async (post) => ({
    slug: post.id,
    title: post.data.title,
    date: post.data.pubDate,
    minutes: await minutesReadOf(post),
    tags: post.data.tags,
    description: post.data.description,
    cover: post.data.cover,
  })),
);
---

<ListSection>
  <ul
    class="divide-y divide-line border-b border-line"
    aria-label="Posts"
    data-listing
  >
    {items.map((item) => (
      <li data-tags={item.tags.join(" ")}>
        <Card item={item} headingLevel={3} layout="list" thumb={thumb} />
      </li>
    ))}
  </ul>
</ListSection>
