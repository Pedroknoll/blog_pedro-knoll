---
import ArticleIcon from "~/assets/brand/icones/icone-artigo.svg";
import FireIcon from "~/assets/brand/icones/icone-fogo.svg";
import PrototypeIcon from "~/assets/brand/icones/icone-prototipo.svg";

// Páginas de lista inteira (T-131, Q24, BRAND §9.2): de `lg` em diante, uma
// lateral sticky com o h1, a contagem e o filtro, na grade da home (15rem e
// 6rem de vão, `max-w-site`); abaixo de `lg`, a lateral fica em cima da lista.

interface Props {
  heading: string;
  icon?: "article" | "prototype" | "fire";
  // Contagem estática, para a lista sem filtro (/tags/<tag>/). Com filtro, a
  // contagem é do TagFilter, no slot `aside`.
  count?: string;
}

const { heading, icon, count } = Astro.props;
const icons = {
  article: ArticleIcon,
  prototype: PrototypeIcon,
  fire: FireIcon,
};
const Icon = icon ? icons[icon] : undefined;
const headingClass =
  "font-display text-4xl font-semibold leading-tight text-balance text-ink sm:text-[2.75rem]";
---

<div class="mx-auto w-full max-w-site px-4 pt-10 pb-10 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-24 lg:pt-14">
  <div class="lg:sticky lg:top-6 lg:self-start">
    <h1 class:list={[headingClass, Icon && "flex items-center gap-3"]}>
      {Icon && (
        <Icon
          aria-hidden="true"
          width={24}
          height={24}
          class="size-6 shrink-0 text-ink"
        />
      )}
      {heading}
    </h1>
    {count !== undefined && (
      <p
        class="mt-3 font-mono text-xs leading-4 tracking-[0.12em] text-pencil uppercase"
        data-count
      >
        {count}
      </p>
    )}
    <slot name="aside" />
  </div>
  <div class="mt-10 min-w-0 lg:mt-0">
    <slot />
  </div>
</div>
