---
import PostVote from "~/components/ui/PostVote.astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div
  class="max-lg:hidden lg:sticky lg:top-30 lg:col-start-1 lg:row-start-2 lg:mt-10 lg:block lg:min-w-0 lg:self-start"
  data-post-rail
>
  <PostVote slug={slug} />
</div>
