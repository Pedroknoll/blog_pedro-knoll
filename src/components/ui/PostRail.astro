---
import KindLabel from "~/components/ui/KindLabel.astro";
import LevelLabel from "~/components/ui/LevelLabel.astro";
import TagList from "~/components/ui/TagList.astro";
import { formatPubDate } from "~/lib/format-date";
import { formatFolio } from "~/lib/folio";
import type { Kind } from "~/lib/kind";
import { site } from "~/site.config";

interface Props {
  title: string;
  folio: number;
  pubDate: Date;
  updatedDate?: Date;
  minutesRead?: number;
  kind: Kind;
  level: number;
  tags: string[];
}

const { title, folio, pubDate, updatedDate, minutesRead, kind, level, tags } =
  Astro.props;

const labelClass = "font-mono text-xs uppercase tracking-widest text-muted";
const rowClass =
  "grid grid-cols-[7rem_minmax(0,1fr)] items-baseline gap-x-3 border-b border-dotted border-line py-[9px] last:border-b-0";
const tagsRowClass =
  "grid gap-y-1.5 border-b border-dotted border-line py-[9px] last:border-b-0";
const published = formatPubDate(pubDate);
const updated = updatedDate ? formatPubDate(updatedDate) : undefined;
---

<div
  class="group contents lg:sticky lg:top-30 lg:block lg:min-w-0 lg:mt-10 lg:self-start"
  data-post-rail
>
  <p
    aria-hidden="true"
    class="pointer-events-none absolute right-0 bottom-[calc(100%_+_0.75rem)] left-0 max-lg:hidden font-display text-[1.75rem] leading-tight font-semibold text-balance text-ink opacity-0 motion-safe:transition-[opacity,translate] group-data-[title-out]:opacity-100"
  >
    {title}
  </p>
  <div class="order-first font-mono text-xs uppercase tracking-widest text-ink lg:border-b lg:border-ink lg:pb-2">
    <span aria-hidden="true">/</span>{" "}
    <div class="inline">{formatFolio(folio)}</div>
  </div>
  <div class="mt-8 border-t border-b border-line lg:mt-0 lg:border-t-0">
    <div class={rowClass}>
      <p class={labelClass}>Data</p>
      <p class="text-sm text-ink">
        <time datetime={published.datetime}>{published.text}</time>
      </p>
    </div>
    {updated && (
      <div class={rowClass}>
        <p class={labelClass}>Atualizado em</p>
        <p class="text-sm text-ink">
          <time datetime={updated.datetime}>{updated.text}</time>
        </p>
      </div>
    )}
    <div class={rowClass}>
      <p class={labelClass}>Leitura</p>
      {typeof minutesRead === "number" && (
        <p class="text-sm text-ink">{minutesRead} min de leitura</p>
      )}
    </div>
    <div class={rowClass}>
      <p class={labelClass}>Tipo</p>
      <KindLabel kind={kind} animated={false} px={12} />
    </div>
    <div class={rowClass}>
      <p class={labelClass}>Nível</p>
      <LevelLabel level={level} />
    </div>
    <div class={rowClass}>
      <p class={labelClass}>Autor</p>
      <p class="text-sm text-ink">{site.author.name}</p>
    </div>
    {tags.length > 0 && (
      <div class={tagsRowClass}>
        <p class={labelClass}>Tags</p>
        <TagList class="flex flex-wrap gap-2" tags={tags} />
      </div>
    )}
  </div>
</div>
<script>
  const rail = document.querySelector("[data-post-rail]");
  const deck = rail?.closest("article")?.querySelector("header > p");
  if (rail && deck) {
    new IntersectionObserver(([entry]) => {
      if (entry) rail.toggleAttribute("data-title-out", !entry.isIntersecting);
    }).observe(deck);
  }
</script>
