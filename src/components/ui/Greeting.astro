---
import Aceno from "~/assets/brand/icones/aceno.svg";
import Wordmark from "~/components/ui/Wordmark.astro";
---

<div class="mx-auto w-full max-w-[52rem] px-4 pt-10">
  <h1 class="text-balance font-display text-[clamp(2.4rem,4.4vw,3.5rem)] leading-[1.1] font-semibold not-italic text-ink">
    <Aceno
      aria-hidden="true"
      class="mr-[0.2em] inline-block size-12 align-[-0.02em] max-[560px]:size-8"
    />
    Bem-vindo ao <Wordmark class="max-[560px]:block" />
  </h1>
  <p class="mt-4 max-w-[42ch] font-sans text-[clamp(1.18rem,2.1vw,1.4rem)] font-normal text-ink">
    Olá, eu sou o Pedro. Aqui documento meus aprendizados e experimentos sobre
    Inteligência Artificial.
  </p>
</div>
