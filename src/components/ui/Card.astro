---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import KindLabel from "~/components/ui/KindLabel.astro";
import LevelLabel from "~/components/ui/LevelLabel.astro";
import TagList from "~/components/ui/TagList.astro";
import { formatPubDate } from "~/lib/format-date";
import { formatFolio } from "~/lib/folio";

interface Props {
  post: CollectionEntry<"posts">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags, cover, folio, kind, level } =
  post.data;
const { text, datetime } = formatPubDate(pubDate);
const href = `/blog/${post.id}/`;
const linkClass =
  "text-ink underline decoration-ink hover:text-accent hover:decoration-accent focus-visible:text-accent focus-visible:decoration-accent";
---

<article
  class:list={[
    "grid items-start gap-y-4 sm:gap-x-8",
    cover
      ? featured
        ? "sm:grid-cols-[minmax(0,1fr)_18rem]"
        : "sm:grid-cols-[minmax(0,1fr)_10.5rem]"
      : undefined,
  ]}
>
  <div class="min-w-0">
    {featured && (
      <p class="mb-2 text-xs tracking-widest text-muted [font-variant-caps:small-caps]">
        Destaque
      </p>
    )}
    <p class="flex flex-wrap items-baseline justify-between gap-x-3 font-mono text-xs text-pencil">
      <span>
        {formatFolio(folio)}
        {" · "}
        <time datetime={datetime}>{text}</time>
      </span>
      <KindLabel kind={kind} animated={false} px={12} />
    </p>
    <h2
      class:list={[
        "font-display font-semibold not-italic leading-snug text-ink",
        featured ? "text-3xl sm:text-4xl" : "text-[1.45rem]",
      ]}
    >
      <a class={linkClass} href={href}>
        {title}
      </a>
    </h2>
    <p class="mt-2 text-muted">{description}</p>
    <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-2">
      <LevelLabel level={level} />
      <TagList class="flex flex-wrap gap-2" tags={tags} />
    </div>
  </div>
  {cover && (
    <div class="aspect-[1200/630] w-full overflow-hidden">
      <Image
        src={cover}
        alt=""
        class="h-full w-full object-cover"
        priority={featured ? true : undefined}
      />
    </div>
  )}
</article>
