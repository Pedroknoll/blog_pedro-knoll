---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import { formatPubDate } from "~/lib/format-date";

interface Props {
  post: CollectionEntry<"posts">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags, cover } = post.data;
const { text, datetime } = formatPubDate(pubDate);
const href = `/blog/${post.id}/`;
const linkClass =
  "text-ink underline decoration-ink hover:text-accent hover:decoration-accent focus-visible:text-accent focus-visible:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<article
  class:list={[
    "grid items-start gap-y-4 sm:gap-x-8",
    cover
      ? featured
        ? "sm:grid-cols-[7rem_minmax(0,1fr)_18rem]"
        : "sm:grid-cols-[7rem_minmax(0,1fr)_10.5rem]"
      : "sm:grid-cols-[7rem_minmax(0,1fr)]",
  ]}
>
  <div>
    {featured && (
      <p class="mb-2 text-xs tracking-widest text-muted [font-variant-caps:small-caps]">
        Destaque
      </p>
    )}
    <time class="block text-sm text-muted" datetime={datetime}>
      {text}
    </time>
  </div>
  <div class="min-w-0">
    <h2
      class:list={[
        "font-serif leading-snug text-ink",
        featured ? "text-3xl sm:text-4xl" : "text-2xl",
      ]}
    >
      <a class={linkClass} href={href}>
        {title}
      </a>
    </h2>
    <p class="mt-2 text-muted">{description}</p>
    {tags.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="border border-line px-2 py-0.5 font-mono text-xs text-muted">
            {tag}
          </span>
        ))}
      </p>
    )}
  </div>
  {cover && (
    <div class="aspect-[1200/630] w-full overflow-hidden">
      <Image
        src={cover}
        alt=""
        class="h-full w-full object-cover"
        priority={featured ? true : undefined}
      />
    </div>
  )}
</article>
