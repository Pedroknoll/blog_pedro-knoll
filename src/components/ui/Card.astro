---
import type { CollectionEntry } from "astro:content";

import Clock from "~/assets/brand/icones/icone-relogio.svg";
import KindLabel from "~/components/ui/KindLabel.astro";
import { formatPubDate } from "~/lib/format-date";

interface Props {
  post: CollectionEntry<"posts">;
  minutesRead: number;
}

const { post, minutesRead } = Astro.props;
const { title, description, pubDate, kind } = post.data;
const { text, datetime } = formatPubDate(pubDate);
const href = `/blog/${post.id}/`;
const linkClass =
  "text-ink no-underline active:text-accent after:absolute after:inset-0";
---

<article class="relative grid gap-y-0 sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:items-center sm:gap-x-8">
  <p class="font-mono text-xs text-pencil sm:col-start-1 sm:row-start-1">
    <time datetime={datetime}>{text}</time>
  </p>
  <div class="min-w-0 sm:col-start-2 sm:row-start-1">
    <h2 class="font-display text-[1.75rem] leading-[1.2] font-semibold text-ink not-italic">
      <a class={linkClass} href={href}>
        {title}
      </a>
    </h2>
    <p class="mt-2 text-[1rem] leading-[1.6] text-muted">{description}</p>
    <p class="footer pointer-events-none mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-1.5 overflow-x-clip font-mono text-xs uppercase tracking-widest">
      <span class="whitespace-nowrap">
        <KindLabel kind={kind} px={12} />
      </span>
      <span class="relative whitespace-nowrap">
        <span
          class="absolute right-full flex w-5 justify-center text-line"
          aria-hidden="true"
        >
          |
        </span>
        <span class="text-pencil">
          <Clock
            aria-hidden="true"
            width={12}
            height={12}
            class="inline-block text-pencil"
          />{" "}
          {minutesRead} min
        </span>
        <span class="sr-only"> de leitura</span>
      </span>
    </p>
  </div>
</article>
