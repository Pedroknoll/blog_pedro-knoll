---
import Clock from "~/assets/brand/icones/icone-relogio.svg";
import Vote from "~/assets/brand/icones/icone-voto.svg";
import { formatPubDate } from "~/lib/format-date";

interface Item {
  slug: string;
  title: string;
  date: Date | string;
  minutes: number;
}

interface Props {
  item: Item;
  headingLevel?: 2 | 3;
  href?: string;
  layout?: "paired" | "columns" | "aligned" | "titles" | "votes";
}

const {
  item,
  headingLevel = 2,
  href: hrefProp,
  layout = "paired",
} = Astro.props;

function asDate(value: Date | string): Date {
  if (value instanceof Date) return value;
  if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
    return new Date(`${value}T00:00:00.000Z`);
  }
  return new Date(value);
}

const showMeta =
  layout === "paired" || layout === "columns" || layout === "aligned";
const formatted = showMeta ? formatPubDate(asDate(item.date)) : null;
const text = formatted?.text ?? "";
const datetime = formatted?.datetime ?? "";
const href = hrefProp ?? `/blog/${item.slug}/`;
const Heading = headingLevel === 3 ? "h3" : "h2";
const linkClass =
  "text-ink no-underline active:text-accent after:absolute after:inset-0";
const titleClass =
  "font-display text-[1.375rem] leading-[1.2] font-semibold text-balance text-ink not-italic sm:text-[1.625rem]";
---

{layout === "titles" ? (
  <article class="relative">
    <Heading class={titleClass}>
      <a class={linkClass} href={href}>
        {item.title}
      </a>
    </Heading>
  </article>
) : layout === "votes" ? (
  <article class="relative flex min-w-0 items-baseline justify-between gap-x-3">
    <Heading class:list={[titleClass, "min-w-0"]}>
      <a class={linkClass} href={href}>
        {item.title}
      </a>
    </Heading>
    <p class="footer pointer-events-none flex shrink-0 items-baseline gap-1 font-mono text-xs text-pencil">
      <Vote
        aria-hidden="true"
        width={10}
        height={8}
        class="inline-block h-2 w-2.5"
      />
      <span class="inline-block w-[3ch] text-right" role="tooltip">
        <span data-vote-value>–</span>
        <span class="sr-only"> votos</span>
      </span>
    </p>
  </article>
) : layout === "columns" ? (
  <article class="relative grid gap-y-2 sm:gap-y-3 lg:grid-cols-[6.5rem_minmax(0,1fr)_auto] lg:items-center lg:gap-x-8 lg:gap-y-0">
    <Heading class:list={[titleClass, "lg:col-start-2 lg:row-start-1"]}>
      <a class={linkClass} href={href}>
        {item.title}
      </a>
    </Heading>
    <div class="flex min-w-0 flex-wrap items-baseline gap-x-3 gap-y-1.5 lg:contents">
      <p class="font-mono text-xs text-pencil lg:col-start-1 lg:row-start-1">
        <time datetime={datetime}>{text}</time>
      </p>
      <p class="footer pointer-events-none flex flex-wrap items-baseline gap-x-2 gap-y-1.5 font-mono text-xs text-pencil lg:col-start-3 lg:row-start-1">
        <span class="whitespace-nowrap">
          <span data-reading>
            <Clock
              aria-hidden="true"
              width={12}
              height={12}
              class="inline-block"
            />{" "}
            {item.minutes} min
          </span>
          <span class="sr-only"> de leitura</span>
        </span>
        <span class="text-line" aria-hidden="true">
          |
        </span>
        <span class="inline-flex items-baseline gap-1 whitespace-nowrap">
          <Vote
            aria-hidden="true"
            width={10}
            height={8}
            class="inline-block h-2 w-2.5"
          />
          <span class="inline-block w-[3ch] text-right" role="tooltip">
            <span data-vote-value>–</span>
            <span class="sr-only"> votos</span>
          </span>
        </span>
      </p>
    </div>
  </article>
) : layout === "aligned" ? (
  <article class="relative grid gap-y-0 sm:grid-cols-[6.5rem_minmax(0,1fr)_auto] sm:items-center sm:gap-x-8">
    <p class="font-mono text-xs text-pencil sm:col-start-1 sm:row-start-1">
      <time datetime={datetime}>{text}</time>
    </p>
    <Heading class:list={[titleClass, "sm:col-start-2 sm:row-start-1"]}>
      <a class={linkClass} href={href}>
        {item.title}
      </a>
    </Heading>
    <p class="footer pointer-events-none mt-2 flex flex-wrap items-baseline justify-end gap-x-2 gap-y-1.5 font-mono text-xs text-pencil sm:col-start-3 sm:row-start-1 sm:mt-0 sm:justify-start">
      <span class="whitespace-nowrap">
        <span data-reading>
          <Clock
            aria-hidden="true"
            width={12}
            height={12}
            class="inline-block"
          />{" "}
          {item.minutes} min
        </span>
        <span class="sr-only"> de leitura</span>
      </span>
      <span class="text-line" aria-hidden="true">
        |
      </span>
      <span class="inline-flex items-baseline gap-1 whitespace-nowrap">
        <Vote
          aria-hidden="true"
          width={10}
          height={8}
          class="inline-block h-2 w-2.5"
        />
        <span class="inline-block w-[3ch] text-right" role="tooltip">
          <span data-vote-value>–</span>
          <span class="sr-only"> votos</span>
        </span>
      </span>
    </p>
  </article>
) : (
  <article class="relative grid gap-y-0 sm:grid-cols-[6.5rem_minmax(0,1fr)] sm:items-center sm:gap-x-8">
    <p class="font-mono text-xs text-pencil sm:col-start-1 sm:row-start-1">
      <time datetime={datetime}>{text}</time>
    </p>
    <div class="min-w-0 sm:col-start-2 sm:row-start-1">
      <Heading class={titleClass}>
        <a class={linkClass} href={href}>
          {item.title}
        </a>
      </Heading>
      <p class="footer pointer-events-none mt-2 flex flex-wrap items-baseline justify-end gap-x-2 gap-y-1.5 font-mono text-xs text-pencil sm:mt-3">
        <span class="whitespace-nowrap">
          <span data-reading>
            <Clock
              aria-hidden="true"
              width={12}
              height={12}
              class="inline-block"
            />{" "}
            {item.minutes} min
          </span>
          <span class="sr-only"> de leitura</span>
        </span>
        <span class="text-line" aria-hidden="true">
          |
        </span>
        <span class="inline-flex items-baseline gap-1 whitespace-nowrap">
          <Vote
            aria-hidden="true"
            width={10}
            height={8}
            class="inline-block h-2 w-2.5"
          />
          <span class="inline-block w-[3ch] text-right" role="tooltip">
            <span data-vote-value>–</span>
            <span class="sr-only"> votos</span>
          </span>
        </span>
      </p>
    </div>
  </article>
)}

<script>
  import { loadVotes } from "~/lib/votes-client";

  const view = window as Window & { __pkVoteItem?: boolean };
  if (!view.__pkVoteItem) {
    view.__pkVoteItem = true;
    void loadVotes().then((votes) => {
      if (!votes) return;
      for (const node of document.querySelectorAll<HTMLElement>(
        "[data-vote-value]",
      )) {
        const article = node.closest("article");
        const link = article?.querySelector("a")?.getAttribute("href") ?? "";
        const slug = /^\/blog\/([a-z0-9-]+)\/$/.exec(link)?.[1];
        if (!slug || !Object.hasOwn(votes, slug)) continue;
        node.textContent = String(votes[slug]);
      }
    });
  }
</script>
