---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import Clock from "~/assets/brand/icones/icone-relogio.svg";
import KindLabel from "~/components/ui/KindLabel.astro";
import LevelLabel from "~/components/ui/LevelLabel.astro";
import { formatPubDate } from "~/lib/format-date";
import { folioDigits } from "~/lib/folio";

interface Props {
  post: CollectionEntry<"posts">;
  featured?: boolean;
  minutesRead: number;
}

const { post, featured = false, minutesRead } = Astro.props;
const { title, description, pubDate, cover, folio, kind, level } = post.data;
const { text, datetime } = formatPubDate(pubDate);
const href = `/blog/${post.id}/`;
const linkClass =
  "text-ink no-underline hover:text-accent hover:underline hover:decoration-accent focus-visible:text-accent focus-visible:underline focus-visible:decoration-accent";
const showCover = Boolean(featured && cover);
---

<article
  class:list={[
    "grid gap-y-0",
    featured
      ? showCover &&
        "sm:grid-cols-[minmax(0,1fr)_18rem] sm:items-start sm:gap-x-8"
      : "sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-center sm:gap-x-8",
  ]}
>
  {featured && (
    <p class="mb-2 text-xs tracking-widest text-muted [font-variant-caps:small-caps] sm:col-start-1 sm:row-start-1">
      Destaque
    </p>
  )}
  <p
    class:list={[
      "font-mono text-xs text-pencil",
      featured
        ? "sm:col-start-1 sm:row-start-2"
        : "sm:col-start-1 sm:row-start-1 sm:flex sm:flex-col sm:items-start",
    ]}
  >
    <span class="whitespace-nowrap">
      Fól.{" "}
      <span class="font-display text-[1.45rem] font-semibold not-italic leading-none text-ink">
        {folioDigits(folio)}
      </span>
    </span>{" "}
    <span class:list={[!featured && "sm:hidden"]}>·</span>{" "}
    <time datetime={datetime}>{text}</time>
  </p>
  <div
    class:list={[
      "min-w-0",
      featured
        ? "sm:col-start-1 sm:row-start-3"
        : "sm:col-start-2 sm:row-start-1",
    ]}
  >
    <h2
      class:list={[
        "font-display font-semibold not-italic leading-snug text-ink",
        featured ? "text-3xl sm:text-4xl" : "text-[1.45rem]",
      ]}
    >
      <a class={linkClass} href={href}>
        {title}
      </a>
    </h2>
    <p class="mt-2 text-muted">{description}</p>
    <p class="footer mt-3 flex flex-wrap items-baseline gap-x-5 overflow-x-clip font-mono text-xs uppercase tracking-widest">
      <span class="whitespace-nowrap">
        <KindLabel kind={kind} animated={false} px={12} />
      </span>
      <span class="relative whitespace-nowrap">
        <span
          class="absolute right-full flex w-5 justify-center text-line"
          aria-hidden="true"
        >
          |
        </span>
        <LevelLabel level={level} />
      </span>
      <span class="relative whitespace-nowrap">
        <span
          class="absolute right-full flex w-5 justify-center text-line"
          aria-hidden="true"
        >
          |
        </span>
        <span class="text-pencil">
          <Clock
            aria-hidden="true"
            width={12}
            height={12}
            class="inline-block text-pencil"
          />{" "}
          {minutesRead} min
        </span>
        <span class="sr-only"> de leitura</span>
      </span>
    </p>
  </div>
  {showCover && cover && (
    <div class="mt-4 aspect-[1200/630] w-full overflow-hidden sm:col-start-2 sm:row-start-1 sm:row-span-3 sm:mt-0">
      <Image src={cover} alt="" class="h-full w-full object-cover" priority />
    </div>
  )}
</article>
