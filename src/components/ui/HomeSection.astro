---
import type { BandLink } from "~/lib/home-lists";

interface Props {
  label: string;
  href: string;
  link: BandLink;
  padded?: boolean;
  compact?: boolean;
}

const { label, href, link, padded = true, compact = false } = Astro.props;
---

<section
  class:list={[
    "mx-auto w-full min-w-0 max-w-[52rem] pt-14 sm:pt-10",
    padded && "px-4",
  ]}
>
  <div class="flex items-baseline justify-between gap-x-4 border-b-2 border-ink pb-2 sm:border-b">
    <h2 class="font-mono text-[15px] uppercase tracking-widest text-ink sm:text-xs">
      {label}
    </h2>
    <a
      class="relative shrink-0 font-mono text-xs whitespace-nowrap text-accent no-underline underline-offset-3 after:absolute after:inset-x-0 after:-inset-y-3.5 hover:underline focus-visible:underline"
      href={href}
    >
      {link.name} <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class:list={[compact ? "mt-2" : "mt-6"]}>
    <slot />
  </div>
</section>
