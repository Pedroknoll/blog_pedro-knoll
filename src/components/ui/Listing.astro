---
import type { CollectionEntry } from "astro:content";

import Card from "~/components/ui/Card.astro";
import { minutesReadOf } from "~/lib/reading-minutes";

// Faixas `/ RECENTES` e `/ PROTÓTIPOS` da home (T-125). As listas inteiras
// usam o PostList (T-131).

interface Props {
  posts: CollectionEntry<"posts">[];
  listLabel: string;
  layout: "recent" | "prototype";
  topBorder?: boolean;
}

const { posts, listLabel, layout, topBorder = true } = Astro.props;
const items = await Promise.all(
  posts.map(async (post) => ({
    slug: post.id,
    title: post.data.title,
    date: post.data.pubDate,
    minutes: await minutesReadOf(post),
    tags: post.data.tags,
    description: post.data.description,
    cover: post.data.cover,
  })),
);
const titles = layout === "prototype";
---

<ul
  class:list={[
    !titles && "divide-y divide-line border-b border-line",
    !titles && topBorder && "border-t",
  ]}
  aria-label={listLabel}
  data-listing
>
  {items.map((item) => (
    <li data-tags={item.tags.join(" ")}>
      <Card item={item} headingLevel={3} layout={layout} />
    </li>
  ))}
</ul>
