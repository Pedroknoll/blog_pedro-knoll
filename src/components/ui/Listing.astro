---
import type { CollectionEntry } from "astro:content";

import Card from "~/components/ui/Card.astro";
import { minutesReadOf } from "~/lib/reading-minutes";

interface Props {
  heading: string;
  showHeading?: boolean;
  posts: CollectionEntry<"posts">[];
  listLabel?: string;
}

const { heading, showHeading = true, posts, listLabel = "Posts" } = Astro.props;
const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    minutesRead: await minutesReadOf(post),
  })),
);
---

<div
  class:list={[
    "mx-auto w-full max-w-[52rem] px-4 pb-10",
    showHeading && "pt-10",
  ]}
  data-listing
>
  {showHeading && (
    <h1 class="font-display text-4xl font-semibold leading-tight text-balance text-ink sm:text-[2.75rem]">
      {heading}
    </h1>
  )}
  <ul
    class:list={["divide-y divide-line", showHeading && "mt-10"]}
    aria-label={listLabel}
  >
    {items.map(({ post, minutesRead }) => (
      <li class="py-8">
        <Card post={post} minutesRead={minutesRead} />
      </li>
    ))}
  </ul>
</div>
