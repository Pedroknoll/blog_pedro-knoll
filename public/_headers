/*
  Content-Security-Policy: default-src 'none'; frame-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-T05-Rule: global

/notebooks/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net 'sha256-J66DGBNYRlkjF6eeQbWMJ8sqzD39RgU33eE7Djfk+M8=' 'sha256-wNw1OS5Za9EAkraslcOYnQGFkuy3QICydhaL3nPEhV4=' 'sha256-Hgm6BtGJry2U0mS4Dxl2bRkghgiWqDdmJCR4Is8WHFU=' 'sha256-TXmhmuKLq9jvARc+ijzS59YJJaxsyhdMnGvrPsOvOlQ='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self' data:; connect-src 'self' https://wasm.marimo.app https://cdn.jsdelivr.net https://files.pythonhosted.org; worker-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  X-T05-Rule: notebooks

/notebooks/:slug/:nome/assets/*
  Cache-Control: public, max-age=31536000, immutable
